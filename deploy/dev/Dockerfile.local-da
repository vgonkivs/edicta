# SPDX-License-Identifier: Apache-2.0
#
# ev-node local DA, built from the ev-node v1.1.4 source. The published image
# ghcr.io/evstack/ev-node-local-da (latest = v1.0.0-rc.1, built 2025-11-12)
# has no blob.Submit method, so ev-node v1.1.4 cannot submit to it. The source
# is pinned by commit, not by tag: 8fc70f075317064f0daaded2a3fed9b1bf095b6f is
# what the annotated tag v1.1.4 points at. DEV ONLY: the DA is in memory.

FROM golang:1.26.8-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0
ADD https://github.com/evstack/ev-node.git#8fc70f075317064f0daaded2a3fed9b1bf095b6f /src
WORKDIR /src/tools/local-da
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -o /out/local-da .

FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
COPY --from=build /out/local-da /usr/bin/local-da
ENTRYPOINT ["/usr/bin/local-da"]
CMD ["-listen-all"]
