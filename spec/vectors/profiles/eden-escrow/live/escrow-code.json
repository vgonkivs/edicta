    "source_code": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.28;\n\n/// @title NativeEscrow\n/// @author bot.fun\n/// @notice Holds native TIA in escrow for inference payments, with facilitator-driven settlement and buyer refunds.\ncontract NativeEscrow {\n    enum State {\n        Funded,\n        Settled,\n        Refunded\n    }\n\n    struct Escrow {\n        address buyer;\n        address payTo;\n        address facilitator;\n        uint256 amount;\n        uint256 expiresAt;\n        uint256 refundAfter;\n        uint256 tiaPriceUsd;\n        State state;\n    }\n\n    mapping(bytes32 paymentId => Escrow escrow) internal escrows;\n\n    /// @notice Emitted when a buyer deposits TIA into escrow.\n    /// @param paymentId Unique identifier for the payment.\n    /// @param buyer Address that deposited funds.\n    /// @param payTo Address that receives funds on settlement.\n    /// @param facilitator Address authorized to settle.\n    /// @param amount Amount of TIA deposited (in wei).\n    /// @param expiresAt Timestamp by which the deposit must be made (price quote validity window).\n    /// @param refundAfter Timestamp after which the buyer may reclaim funds.\n    /// @param tiaPriceUsd Snapshot TIA/USD price at deposit time (18-decimal fixed-point).\n    event NativeEscrowDeposited(\n        bytes32 indexed paymentId,\n        address indexed buyer,\n        address indexed payTo,\n        address facilitator,\n        uint256 amount,\n        uint256 expiresAt,\n        uint256 refundAfter,\n        uint256 tiaPriceUsd\n    );\n\n    /// @notice Emitted when a facilitator settles an escrow.\n    /// @param paymentId Unique identifier for the payment.\n    /// @param payTo Address that received the settled amount.\n    /// @param buyer Address that receives any refund.\n    /// @param actualAmount Amount paid to the payTo address.\n    /// @param refundAmount Amount refunded to the buyer.\n    event NativeEscrowSettled(\n        bytes32 indexed paymentId,\n        address indexed payTo,\n        address indexed buyer,\n        uint256 actualAmount,\n        uint256 refundAmount\n    );\n\n    /// @notice Emitted when a buyer reclaims funds from an expired escrow.\n    /// @param paymentId Unique identifier for the payment.\n    /// @param buyer Address that received the refund.\n    /// @param refundAmount Amount refunded.\n    event NativeEscrowRefunded(bytes32 indexed paymentId, address indexed buyer, uint256 indexed refundAmount);\n\n    /// @notice Deposit native TIA into escrow for a future inference payment.\n    /// @param paymentId Unique identifier for the payment (must not already exist).\n    /// @param payTo Address that will receive funds when the escrow is settled.\n    /// @param facilitator Address authorized to settle this escrow.\n    /// @param expiresAt Timestamp by which the deposit must be made (price quote validity window).\n    /// @param refundAfter Timestamp after which the buyer may reclaim funds.\n    /// @param tiaPriceUsd Snapshot TIA/USD price at deposit time (18-decimal fixed-point).\n    function deposit(\n        bytes32 paymentId,\n        address payTo,\n        address facilitator,\n        uint256 expiresAt,\n        uint256 refundAfter,\n        uint256 tiaPriceUsd\n    ) external payable {\n        require(escrows[paymentId].amount == 0, \"payment id already used\");\n        require(msg.value > 0, \"amount must be positive\");\n        // solhint-disable-next-line not-rely-on-time\n        require(expiresAt > block.timestamp, \"already expired\");\n        require(refundAfter > expiresAt, \"refund time must be after expiry\");\n        require(tiaPriceUsd > 0, \"invalid tia price\");\n\n        escrows[paymentId] = Escrow({\n            buyer: msg.sender,\n            payTo: payTo,\n            facilitator: facilitator,\n            amount: msg.value,\n            expiresAt: expiresAt,\n            refundAfter: refundAfter,\n            tiaPriceUsd: tiaPriceUsd,\n            state: State.Funded\n        });\n\n        emit NativeEscrowDeposited(\n            paymentId,\n            msg.sender,\n            payTo,\n            facilitator,\n            msg.value,\n            expiresAt,\n            refundAfter,\n            tiaPriceUsd\n        );\n    }\n\n    /// @notice Settle multiple escrows in a single transaction.\n    /// @param paymentIds Array of payment identifiers to settle.\n    /// @param actualAmounts Array of actual amounts consumed (must match length of paymentIds).\n    function settleBatch(bytes32[] calldata paymentIds, uint256[] calldata actualAmounts) external {\n        require(paymentIds.length == actualAmounts.length, \"length mismatch\");\n        for (uint256 i = 0; i < paymentIds.length; ++i) {\n            _settle(paymentIds[i], actualAmounts[i]);\n        }\n    }\n\n    /// @notice Settle a single escrow, paying the provider and refunding any remainder to the buyer.\n    /// @param paymentId Unique identifier for the payment.\n    /// @param actualAmount Amount consumed by inference (must not exceed the escrowed amount).\n    function settle(bytes32 paymentId, uint256 actualAmount) external {\n        _settle(paymentId, actualAmount);\n    }\n\n    /// @notice Refund the full escrowed amount to the buyer after the refund window opens.\n    /// @param paymentId Unique identifier for the payment.\n    function refundExpired(bytes32 paymentId) external {\n        Escrow storage e = escrows[paymentId];\n        require(e.amount > 0, \"unknown payment\");\n        require(e.state == State.Funded, \"not funded\");\n        // solhint-disable-next-line not-rely-on-time\n        require(block.timestamp > e.refundAfter, \"refund not yet available\");\n\n        e.state = State.Refunded;\n        uint256 refundAmount = e.amount;\n\n        (bool ok, ) = e.buyer.call{ value: refundAmount }(\"\");\n        require(ok, \"refund failed\");\n\n        emit NativeEscrowRefunded(paymentId, e.buyer, refundAmount);\n    }\n\n    /// @notice Return the full escrow record for a given payment.\n    /// @param paymentId Unique identifier for the payment.\n    /// @return The Escrow struct.\n    function getEscrow(bytes32 paymentId) external view returns (Escrow memory) {\n        return escrows[paymentId];\n    }\n\n    /// @notice Check whether an escrow exists and is still in the Funded state.\n    /// @param paymentId Unique identifier for the payment.\n    /// @return True if the escrow is funded.\n    function isFunded(bytes32 paymentId) external view returns (bool) {\n        return escrows[paymentId].state == State.Funded && escrows[paymentId].amount > 0;\n    }\n\n    /// @notice Check whether an escrow can be settled (funded with a positive amount).\n    /// @param paymentId Unique identifier for the payment.\n    /// @return True if the escrow is settleable.\n    function isSettleable(bytes32 paymentId) external view returns (bool) {\n        Escrow storage e = escrows[paymentId];\n        return e.state == State.Funded && e.amount > 0;\n    }\n\n    /// @notice Internal settlement logic shared by settle and settleBatch.\n    /// @param paymentId Unique identifier for the payment.\n    /// @param actualAmount Amount consumed by inference.\n    function _settle(bytes32 paymentId, uint256 actualAmount) internal {\n        Escrow storage e = escrows[paymentId];\n        require(e.amount > 0, \"unknown payment\");\n        require(e.state == State.Funded, \"not funded\");\n        require(msg.sender == e.facilitator, \"not facilitator\");\n        require(actualAmount <= e.amount, \"exceeds amount\");\n\n        e.state = State.Settled;\n\n        uint256 refundAmount = e.amount - actualAmount;\n\n        if (actualAmount > 0) {\n            (bool ok, ) = e.payTo.call{ value: actualAmount }(\"\");\n            require(ok, \"seller payment failed\");\n        }\n        if (refundAmount > 0) {\n            (bool ok, ) = e.buyer.call{ value: refundAmount, gas: 30000 }(\"\");\n            if (!ok) {\n                (bool ok2, ) = e.facilitator.call{ value: refundAmount }(\"\");\n                require(ok2, \"facilitator payment failed\");\n            }\n        }\n\n        emit NativeEscrowSettled(paymentId, e.payTo, e.buyer, actualAmount, refundAmount);\n    }\n}\n"
  },
