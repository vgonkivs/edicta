  "allowlist": [
    "application/vnd.edicta.ibkr.order.v0+cbor",
    "application/json",
    "application/octet-stream",
    "application/vnd.edicta.test.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa+cbor"
