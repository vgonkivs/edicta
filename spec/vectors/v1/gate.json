    {
      "id": "defaults_fast_mode",
      "description": "FastMode with a namespace, a mandate and every default.",
      "config": {
        "fast_mode": true,
        "pending_namespaces": [
          "000000000000000000000000000000000000006564696374612f643031"
        ]
      },
      "mandate": true,
      "expect": {
        "result": "ok"
      }
    },
    {
      "id": "fast_mode_without_mandate",
      "description": "FastMode at a gate without a mandate: no mandate, no fast mode.",
      "config": {
        "fast_mode": true,
        "pending_namespaces": [
          "000000000000000000000000000000000000006564696374612f643031"
        ]
      },
      "mandate": false,
      "expect": {
        "error": "ErrInvalidConfig",
        "cause": "fast_mode_without_mandate"
      }
    },
    {
      "id": "strict_without_mandate",
      "description": "FastMode off and no mandate: accepted.",
      "config": {
        "fast_mode": false
      },
      "mandate": false,
      "expect": {
        "result": "ok"
      }
