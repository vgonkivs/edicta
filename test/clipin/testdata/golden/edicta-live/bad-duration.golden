  -record-token-file string
    	file with edictad's record bearer token, if it differs
  -rpc-primary string
    	light: CometBFT RPC URL of the primary provider
  -rpc-witness value
    	light: CometBFT RPC URL of a witness from another operator (repeatable or comma separated)
  -skew uint
    	clock skew in seconds; must equal the gate's (default 30)
  -strategy-id string
    	strategy id carried in the context (default "tia-band-live")
  -threshold-bp uint
    	move in basis points that triggers a decision (100 = 1%) (default 100)
  -timeout duration
    	overall time limit of the run (default 30m0s)
  -trust-hash string
